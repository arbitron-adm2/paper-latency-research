{
  "manifest_version": 3,
  "name": "\u041e\u0447\u0435\u0440\u0435\u0434\u044c papertrade \u00b7 \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0438",
  "version": "1.4.0",
  "description": "\u041e\u0447\u0435\u0440\u0435\u0434\u044c, \u0437\u0430\u0434\u0435\u0440\u0436\u043a\u0438, timing-\u0444\u0438\u043b\u044c\u0442\u0440 shadow, \u0442\u0438\u043a\u0438 Binance \u043d\u0430 \u0433\u0440\u0430\u0444\u0438\u043a\u0435 Paper, \u0441\u043f\u0440\u0435\u0434 \u0432 bp \u0441 \u0441\u043e\u0432\u0435\u0442\u043e\u043c guard \u0438 \u0431\u044b\u0441\u0442\u0440\u044b\u0435 \u043a\u043d\u043e\u043f\u043a\u0438 \u041b\u043e\u043d\u0433/\u0428\u043e\u0440\u0442/\u0417\u0430\u043a\u0440\u044b\u0442\u044c \u0432\u0441\u0451 (\u043d\u0430\u0436\u0438\u043c\u0430\u044e\u0442 \u0448\u0442\u0430\u0442\u043d\u044b\u0435 \u043a\u043d\u043e\u043f\u043a\u0438 \u0431\u0438\u0440\u0436\u0438; \u043a\u043b\u044e\u0447\u0435\u0439 \u043d\u0435\u0442).",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://exchange.papertrade.xyz/*",
    "https://paperwatch.app/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://exchange.papertrade.xyz/*"
      ],
      "js": [
        "src/core.js",
        "src/latency.js",
        "src/pump.js",
        "src/trader.js",
        "src/panel.js",
        "src/chart-overlay.js",
        "src/latency-panel.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://exchange.papertrade.xyz/*"
      ],
      "js": [
        "src/chart-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "\u041e\u0447\u0435\u0440\u0435\u0434\u044c papertrade \u2014 \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c / \u0441\u043f\u0440\u044f\u0442\u0430\u0442\u044c \u043e\u043a\u043d\u043e (\u043d\u0430 \u0432\u043a\u043b\u0430\u0434\u043a\u0435 \u0431\u0438\u0440\u0436\u0438)"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c / \u0441\u043f\u0440\u044f\u0442\u0430\u0442\u044c \u043e\u043a\u043d\u043e \u043e\u0447\u0435\u0440\u0435\u0434\u0438"
    }
  },
  "options_page": "diagnostics.html"
}
